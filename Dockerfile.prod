# ── RUTHAMBHARA Agentic Film Studio — production image ────────────────────────
# The built-in server-rendered dashboard is the supported UI, so no Node build
# step is required.  `web/` remains available as an optional Next.js client.
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    PIP_NO_CACHE_DIR=1 \
    AFP_ENV=production \
    AFP_HOST=0.0.0.0 \
    AFP_PORT=8080

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

RUN pip install --upgrade pip \
    && pip install ".[rag]" \
    && mkdir -p output

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8080/health || exit 1

CMD ["python", "main.py", "serve", "--host", "0.0.0.0", "--port", "8080"]
