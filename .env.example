# ── RUTHAMBHARA Agentic Film Studio ───────────────────────────────────────────
# Copy to `.env` (the app auto-loads it) and override anything you need.
# Everything has a free, offline default — no API keys required.

# ── Server ───────────────────────────────────────────────────────────────────
AFP_ENV=development
AFP_HOST=0.0.0.0
AFP_PORT=8080
AFP_CORS_ORIGINS=*

# ── Screenplay ───────────────────────────────────────────────────────────────
# Absolute or relative path.  Defaults to the bundled data/ruthambhara_script.md.
# AFP_SCRIPT_PATH=data/ruthambhara_script.md

# ── Pipeline ─────────────────────────────────────────────────────────────────
AFP_MODE=hybrid                # hybrid | parallel | sequential
AFP_SCOPE=sample               # sample | analysis | full
AFP_TIER=free                  # free | premium
AFP_SAMPLE_SEQUENCES=3
AFP_SAMPLE_MAX_SHOTS=12
AFP_MAX_WORKERS=4
AFP_QUALITY_THRESHOLD=0.80
AFP_MAX_REPAIR_LOOPS=2
AFP_REQUIRE_APPROVAL=0

# ── Media ────────────────────────────────────────────────────────────────────
AFP_RENDER_MEDIA=1
AFP_RENDER_VIDEO=1
AFP_STORYBOARD_WIDTH=640
AFP_STORYBOARD_HEIGHT=360
AFP_MAX_RENDER_SHOTS=0         # 0 = all sampled shots
AFP_TTS_BACKEND=wav            # auto | edge | pyttsx3 | wav   (wav = offline)
AFP_TTS_VOICE=te-IN-ShrutiNeural
AFP_FFMPEG=ffmpeg
AFP_VIDEO_FPS=24
AFP_VIDEO_WIDTH=1280
AFP_VIDEO_HEIGHT=720

# ── Free local LLM (opt-in: CPU inference is slower than the reasoner) ───────
AFP_USE_OLLAMA=0
OLLAMA_BASE_URL=http://localhost:11434
AFP_OLLAMA_MODEL=llama3.2:3b
AFP_LLM_TIMEOUT=2.5

# ── Premium providers (optional; disabled unless you opt in) ────────────────
AFP_PREMIUM_ENABLED=0
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=

# ── Retrieval (GraphRAG) ─────────────────────────────────────────────────────
AFP_EMBEDDING_DIM=384
AFP_CHUNK_SIZE=700
AFP_CHUNK_OVERLAP=80
AFP_RAG_TOP_K=6

# ── Guardrails ───────────────────────────────────────────────────────────────
AFP_GUARDRAIL_STRICT=1
AFP_MAX_SCRIPT_CHARS=2000000
